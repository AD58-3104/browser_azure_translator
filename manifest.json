{
  "manifest_version": 3,
  "name": "原文⇄翻訳トグル",
  "version": "1.5.0",
  "description": "ページを Azure Translator またはローカルの Ollama で翻訳し、ショートカット一つで原文と訳文を瞬時に切り替えます。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.cognitive.microsofttranslator.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "翻訳 / 原文を切り替え (Alt+T)"
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "翻訳と原文を切り替え"
    },
    "retranslate-hq": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "マウスの下の段落を高品質モデルで再翻訳"
    },
    "retranslate-light": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "マウスの下の段落を通常モデル（軽量）で再翻訳"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}